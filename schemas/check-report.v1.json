{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacocartones.github.io/market-data-sanity-checker/schemas/check-report.v1.json",
  "title": "mdsc check report (v1)",
  "description": "JSON output of `mdsc check --format json` (the SanityReport of market-data-sanity-checker 1.x).",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sanity_score": {
      "type": "number",
      "description": "0–100: 100 minus the sum of severity penalties."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "description": "Stable rule identifier, e.g. SPLIT_NOT_ADJUSTED."
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "block",
              "flag",
              "review"
            ],
            "description": "What to do with the flagged datum: block it, flag it, or send it to manual review."
          },
          "dimension": {
            "type": "string",
            "enum": [
              "completeness",
              "validity",
              "accuracy",
              "consistency",
              "timeliness",
              "uniqueness"
            ],
            "description": "DAMA-DMBOK data quality dimension."
          },
          "where": {
            "description": "Where in the dataset the problem lives, e.g. { \"date\": \"2024-06-03\" }.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "description": "Human-readable explanation with the causal hypothesis and the evidence behind it."
          },
          "evidence": {
            "description": "Rule-specific evidence values.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "references": {
            "description": "URLs to the real-world incident or literature justifying the rule's threshold.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "occurrences": {
            "description": "How many times this rule fired; a rule reports once per dataset.",
            "type": "number"
          }
        },
        "required": [
          "rule",
          "severity",
          "action",
          "dimension",
          "explanation"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "number"
        },
        "warning": {
          "type": "number"
        },
        "info": {
          "type": "number"
        }
      },
      "required": [
        "critical",
        "warning",
        "info"
      ],
      "description": "Per-severity count of distinct rules that fired (not occurrences)."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the report was generated."
    }
  },
  "required": [
    "symbol",
    "source",
    "sanity_score",
    "findings",
    "summary",
    "generated_at"
  ]
}
