{
    "name": "market-data-sanity-checker",
    "version": "1.2.0",
    "description": "Trust layer for market data: validate, score and explain anomalies in OHLCV, dividends, splits and fundamentals before they break your product.",
    "keywords": [
        "market data",
        "data quality",
        "data validation",
        "validation",
        "ohlcv",
        "stock data",
        "stocks",
        "equities",
        "dividends",
        "splits",
        "corporate actions",
        "anomaly detection",
        "data observability",
        "financial data",
        "trading",
        "quant",
        "fintech",
        "yahoo finance",
        "sanity check",
        "cli"
    ],
    "license": "MIT",
    "author": "Manuel Sánchez",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pacocartones/market-data-sanity-checker.git"
    },
    "bugs": "https://github.com/pacocartones/market-data-sanity-checker/issues",
    "homepage": "https://github.com/pacocartones/market-data-sanity-checker#readme",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "mdsc": "./dist/cli.js",
        "market-data-sanity-checker": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "build": "tsup",
        "prepack": "pnpm build",
        "dev": "tsx src/cli.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "calibrate": "tsx scripts/calibrate.ts",
        "scoreboard": "tsx scripts/scoreboard.ts",
        "coverage:summary": "tsx scripts/generate-coverage-summary.ts",
        "coverage:check": "pnpm test:coverage && pnpm coverage:summary"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "papaparse": "^5.5.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.1",
        "@types/papaparse": "^5.5.2",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.11"
    }
}
