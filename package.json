{
    "name": "market-data-sanity-checker",
    "version": "1.8.0",
    "description": "Trust layer for market data: validate, score and explain anomalies in OHLCV, dividends, splits and fundamentals before they break your product.",
    "keywords": [
        "market data",
        "data quality",
        "data validation",
        "validation",
        "ohlcv",
        "stock data",
        "stocks",
        "equities",
        "dividends",
        "splits",
        "corporate actions",
        "anomaly detection",
        "data observability",
        "financial data",
        "trading",
        "quant",
        "fintech",
        "yahoo finance",
        "sanity check",
        "cli"
    ],
    "license": "MIT",
    "author": "pacocartones",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pacocartones/market-data-sanity-checker.git"
    },
    "bugs": "https://github.com/pacocartones/market-data-sanity-checker/issues",
    "homepage": "https://github.com/pacocartones/market-data-sanity-checker#readme",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "mdsc": "./dist/cli.js",
        "market-data-sanity-checker": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./schemas/check-report.v1.json": "./schemas/check-report.v1.json",
        "./schemas/compare-report.v1.json": "./schemas/compare-report.v1.json"
    },
    "files": [
        "dist",
        "schemas"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22.12"
    },
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "build": "tsup",
        "prepack": "pnpm build",
        "dev": "tsx src/cli.ts",
        "test": "vitest run",
        "test:property": "vitest run tests/property",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "schemas": "tsx scripts/generate-schemas.ts",
        "calibrate": "tsx scripts/calibrate.ts",
        "scoreboard": "tsx scripts/scoreboard.ts",
        "coverage:summary": "tsx scripts/generate-coverage-summary.ts",
        "coverage:badge": "tsx scripts/coverage-badge.ts",
        "coverage:check": "pnpm test:coverage && pnpm coverage:summary",
        "smoke:readme": "tsx scripts/readme-smoke.ts",
        "release-notes": "tsx scripts/release-notes.ts",
        "version-packages": "changeset version && node scripts/sync-floor-fixture-version.mjs",
        "incidents:index": "tsx scripts/incidents-index.ts",
        "incidents:check": "tsx scripts/incidents-index.ts --check"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "papaparse": "^5.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.4",
        "@types/papaparse": "^5.5.2",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^10.15.0",
        "fast-check": "4.10.3",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^4.1.12",
        "yaml": "2.9.1"
    }
}
